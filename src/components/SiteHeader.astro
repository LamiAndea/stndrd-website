---
import Wordmark from './Wordmark.astro';
import CartIcon from './CartIcon.astro';

// linkHome: on pages other than the landing page the logo navigates home
// instead of scrolling to top (the scroll behavior needs the landing script).
interface Props {
  linkHome?: boolean;
}
const { linkHome = false } = Astro.props;
---
<header class="site-header">
  {linkHome ? (
    <a class="logo" href="/" aria-label="STNDRD, home"><Wordmark /></a>
  ) : (
    <button class="logo" data-scroll="top" aria-label="STNDRD, back to top"><Wordmark /></button>
  )}
  <nav class="site-nav" aria-label="Site">
    <a href="/shop">Shop</a>
    <CartIcon />
  </nav>
</header>
