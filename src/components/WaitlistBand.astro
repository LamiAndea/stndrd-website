---
---
<div class="shop-band">
  <h2>Get the launch email. Nothing else.</h2>

  <div class="band-signup-confirm" id="band-confirm" role="status" hidden>
    You're on the list. We'll email once — when it ships.
  </div>

  <form class="band-signup" id="band-form" novalidate>
    <div class="band-signup-row">
      <input type="email" id="band-email" name="email" autocomplete="email" spellcheck="false" placeholder="you@email.com" aria-label="Email address" aria-describedby="band-error" required>
      <input type="text" name="company" id="band-company" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button type="submit" id="band-join">Join</button>
    </div>
    <span class="band-signup-error" id="band-error" role="alert">That address looks incomplete.</span>
    <span class="band-helper">Waitlist gets the launch discount.</span>
  </form>
</div>
