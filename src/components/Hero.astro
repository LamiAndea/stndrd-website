---
import { Picture } from 'astro:assets';
import heroShot from '../assets/HeroShot.jpeg';
---
<section class="hero ph">
  <Picture
    src={heroShot}
    formats={['avif', 'webp']}
    widths={[640, 960, 1365]}
    sizes="100vw"
    alt="STNDRD lip balm tube resting diagonally on a light grey surface"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-inner">
    <span class="eyebrow">PRE-LAUNCH · ONE PRODUCT</span>
    <h1>Three Ingredients. Nothing Else.</h1>
    <p>No scent. No shine. Lip balm that does the one thing and stops.</p>
    <div class="hero-cta-wrap">
      <div class="hero-signup-confirm" id="hero-signup-confirm" role="status" hidden>
        You're on the list. We'll email once — when it ships.
      </div>
      <form class="hero-signup-form" id="hero-signup-form" novalidate>
        <div class="hero-signup-row">
          <input type="email" id="hero-signup-email" name="email" autocomplete="email" spellcheck="false" placeholder="you@email.com" aria-label="Email address" aria-describedby="hero-signup-error" required>
          <input type="text" name="company" id="hero-signup-company" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true">
          <button type="submit" id="hero-signup-submit">Join</button>
        </div>
        <span class="hero-signup-error" id="hero-signup-error" role="alert">That address looks incomplete.</span>
      </form>
    </div>
  </div>
</section>
